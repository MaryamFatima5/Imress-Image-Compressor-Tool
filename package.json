{
  "name": "imress-image-compressor",
  "version": "1.0.0",
  "description": "High performance desktop and web image compression tool",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "electron": "electron .",
    "backend": "node backend/server.js",
    "test": "node -e \"console.log('OK')\"",
    "build": "electron-builder --win",
    "build:nsis": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:dir": "electron-builder --dir"
  },
  "keywords": [
    "image-compressor",
    "electron",
    "sharp",
    "offline",
    "desktop"
  ],
  "author": "Imress",
  "license": "MIT",
  "dependencies": {
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.imress.image-compressor",
    "productName": "Imress",
    "copyright": "Copyright © 2026 Imress",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build-resources"
    },
    "files": [
      "electron/**/*",
      "backend/server.js",
      "frontend/**/*",
      "!frontend/templates/**",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [],
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "frontend/static/images/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "frontend/static/images/icon.ico",
      "uninstallerIcon": "frontend/static/images/icon.ico",
      "installerHeaderIcon": "frontend/static/images/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Imress",
      "uninstallDisplayName": "Imress - Image Compressor",
      "deleteAppDataOnUninstall": true
    },
    "portable": {
      "artifactName": "Imress-Portable-${version}.${ext}"
    }
  }
}
